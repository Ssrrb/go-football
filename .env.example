APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://football:football@localhost:5432/football?sslmode=disable
# Redis is reserved capacity for a future ranking read model. No process writes
# sorted sets yet, so this connection is only used by /health/ready.
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
# Pooled connections kept open and warm. A TLS handshake to a remote pooler
# costs far more than the queries, so keep a couple ready.
DB_MIN_CONNS=2
# 0 keeps the pgxpool default of the greater of 4 or the CPU count.
DB_MAX_CONNS=0
# How long a computed ranking is reused in-process. 0 disables the cache.
LEADERBOARD_CACHE_TTL=15s
# How long a live season-award projection is reused in-process. Recomputing it
# scans the whole edition, and /premios is polled by every open tab, so this is
# kept well above the leaderboard TTL. 0 disables the cache.
SEASON_AWARDS_CACHE_TTL=60s
EDITION_ID=
# Use "default" for average player_match_stat ratings, or a scoring_model UUID.
SCORING_MODEL_ID=default
SHUTDOWN_TIMEOUT=10s
SESSION_DURATION=720h
# Optional override; defaults to true when APP_ENV=production and false otherwise.
COOKIE_SECURE=
# Google Cloud OAuth 2.0 Web application credentials (all three or none).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Example: http://localhost:8080/auth/google/callback
GOOGLE_REDIRECT_URL=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# Set this to the deployed Git SHA or release version.
SENTRY_RELEASE=
