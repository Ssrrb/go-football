APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://football:football@localhost:5432/football?sslmode=disable
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
EDITION_ID=
# Use "default" for average player_match_stat ratings, or a scoring_model UUID.
SCORING_MODEL_ID=default
SHUTDOWN_TIMEOUT=10s
SESSION_DURATION=720h
# Optional override; defaults to true when APP_ENV=production and false otherwise.
COOKIE_SECURE=
# Google Cloud OAuth 2.0 Web application credentials (all three or none).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Example: http://localhost:8080/auth/google/callback
GOOGLE_REDIRECT_URL=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# Set this to the deployed Git SHA or release version.
SENTRY_RELEASE=
