{
  "specification": "go-football/season-awards",
  "catalog_version": 3,
  "status": "active",
  "normalization": {
    "method": "positional_robust_z_score",
    "formula": "(x - median(position, metric)) / (1.4826 * MAD(position, metric))",
    "fallback": "use positional standard Z-score when MAD is zero; use 0 when the cohort has no dispersion",
    "cohort": "players in the same edition, resolved position and calculation window",
    "rate_adjustment": "shrink rates toward the positional cohort rate with metric-specific pseudo-attempts before standardization",
    "missing_data": "a required unavailable metric makes the player ineligible; zero is used only when source semantics establish that an omitted count means no actions"
  },
  "common_metrics": {
    "provider_rating_policy": "provider-published player ratings are never inputs",
    "attack": "per90(5*goals + 3*assists + 0.5*shots_on_target)",
    "progression": "per90(total_progression + progressive_carries + 2*key_passes)",
    "defence": "per90(1.5*tackles_won + 1.5*interceptions + 0.75*blocks + 0.5*recoveries + 0.5*clearances + 0.2*duels_won - errors)",
    "control": "0.50*adjusted_pass_rate + 0.25*adjusted_duel_rate + 0.25*adjusted_dribble_rate - 0.25*possession_lost/touches",
    "influence": "per90(touches + 4*key_passes + 2*shots + 2*fouls_suffered)",
    "position_weights": "GK=(.05,.10,.10,.30,.45); DEF=(.10,.20,.35,.20,.15); MID=(.15,.30,.15,.20,.20); FWD=(.35,.20,.05,.15,.25) for (attack,progression,defence,control,influence)",
    "quality": "Q = weighted positional sum of robust-Z attack, progression, defence, control and influence",
    "reliability": "R = minutes / (minutes + 900)",
    "reliable_base": "B = Q * R",
    "season_volume": "V = sqrt(minutes / maximum player minutes in the relevant edition cohort)",
    "public_scale": "raw standardized score determines ranking; 100/(1+exp(-raw_score)) is display-only"
  },
  "awards": [
    {
      "id": "30000000-0000-4000-8000-000000000001",
      "code": "PLAYER_OF_SEASON",
      "name": "Jugador de la temporada",
      "version": 3,
      "status": "active",
      "eligibility": {"resolved_position_required": true, "provisional": "one finished appearance; R controls small samples"},
      "aggregation": "weighted_standardized_components",
      "components": [
        {"code": "reliable_base", "weight": 0.85, "direction": "higher", "metric": "B = Q*minutes/(minutes+900)"},
        {"code": "season_volume", "weight": 0.15, "direction": "higher", "metric": "sqrt(minutes/maximum player minutes)"}
      ],
      "final_formula": "JTS = 0.85*B + 0.15*V",
      "tie_breakers": ["higher raw JTS", "higher total minutes", "player UUID ascending"]
    },
    {
      "id": "30000000-0000-4000-8000-000000000002",
      "code": "DEFENDER_OF_SEASON",
      "name": "Defensa de la temporada",
      "version": 3,
      "status": "active",
      "eligibility": {"position": "DEF", "provisional": "one finished appearance; R controls small samples"},
      "aggregation": "weighted_standardized_components",
      "components": [
        {"code": "reliable_base", "weight": 0.35, "direction": "higher", "metric": "common B for DEF"},
        {"code": "reliable_defence", "weight": 0.50, "direction": "higher", "metric": "specialist DEF robust-Z score * minutes/(minutes+900)"},
        {"code": "season_volume", "weight": 0.15, "direction": "higher", "metric": "sqrt(minutes/maximum defender minutes)"}
      ],
      "final_formula": "DTS = 0.35*B + 0.50*(DEF*R) + 0.15*V",
      "tie_breakers": ["higher raw DTS", "higher specialist defence", "higher total minutes", "player UUID ascending"]
    },
    {
      "id": "30000000-0000-4000-8000-000000000003",
      "code": "GOALKEEPER_OF_SEASON",
      "name": "Portero de la temporada",
      "version": 3,
      "status": "active",
      "eligibility": {"position": "GK", "minimum_shots_on_target_faced": 1},
      "aggregation": "weighted_standardized_components",
      "components": [
        {"code": "reliable_base", "weight": 0.25, "direction": "higher", "metric": "common B for GK"},
        {"code": "reliable_shot_stopping", "weight": 0.35, "direction": "higher", "metric": "Z(adjusted save percentage)*SOTFaced/(SOTFaced+100)"},
        {"code": "distribution", "weight": 0.15, "direction": "higher", "metric": "Z(adjusted pass and long-ball accuracy)"},
        {"code": "cross_control", "weight": 0.075, "direction": "higher", "metric": "Z((high claims+punches)/90)"},
        {"code": "sweeping", "weight": 0.075, "direction": "higher", "metric": "Z(adjusted keeper-sweeper success rate)"},
        {"code": "error_avoidance", "weight": 0.05, "direction": "higher", "metric": "Z(-errors leading to shots or goals per90)"},
        {"code": "season_volume", "weight": 0.05, "direction": "higher", "metric": "sqrt(minutes/maximum goalkeeper minutes)"}
      ],
      "final_formula": "PTS = .25*B + .35*ShotStop* + .15*Distribution + .075*CrossControl + .075*Sweeping + .05*ErrorAvoidance + .05*V",
      "tie_breakers": ["higher reliable shot stopping", "higher save percentage", "higher total minutes", "player UUID ascending"]
    },
    {
      "id": "30000000-0000-4000-8000-000000000004",
      "code": "YOUNG_PLAYER_OF_SEASON",
      "name": "Jugador joven de la temporada (Sub-23)",
      "version": 3,
      "status": "active",
      "eligibility": {"age_rule": "age < 23 on edition.starts_on; date_of_birth is required", "resolved_position_required": true},
      "aggregation": "weighted_standardized_components",
      "components": [
        {"code": "reliable_base", "weight": 0.85, "direction": "higher", "metric": "same B as PLAYER_OF_SEASON"},
        {"code": "season_volume", "weight": 0.15, "direction": "higher", "metric": "same V as PLAYER_OF_SEASON"}
      ],
      "final_formula": "JJTS = 0.85*B + 0.15*V; age < 23; no age bonus",
      "tie_breakers": ["higher raw JJTS", "higher total minutes", "player UUID ascending"]
    },
    {
      "id": "30000000-0000-4000-8000-000000000005",
      "code": "IMPACT_SUBSTITUTE_OF_SEASON",
      "name": "Suplente más decisivo de la temporada",
      "version": 3,
      "status": "active",
      "eligibility": {"minimum_substitute_appearances": 1, "only_statistics_after_entering_count": true},
      "aggregation": "weighted_standardized_components",
      "components": [
        {"code": "reliable_impact", "weight": 0.55, "direction": "higher", "metric": "positional Z(sum(ActionValue*Leverage))*substitute_minutes/(substitute_minutes+450)"},
        {"code": "reliable_substitute_base", "weight": 0.25, "direction": "higher", "metric": "Q_sub*substitute_minutes/(substitute_minutes+450)"},
        {"code": "substitute_volume", "weight": 0.20, "direction": "higher", "metric": "sqrt(substitute appearances/maximum substitute appearances)"}
      ],
      "final_formula": "SMS = .55*Impact* + .25*B_sub + .20*V_sub",
      "tie_breakers": ["higher raw SMS", "higher leverage-weighted impact", "more substitute appearances", "player UUID ascending"]
    },
    {
      "id": "30000000-0000-4000-8000-000000000006",
      "code": "MOST_IMPROVED_PLAYER",
      "name": "Jugador con mayor progresión",
      "version": 3,
      "status": "active",
      "eligibility": {"windows": "first half versus second half based on the edition gameweek count; both windows require minutes"},
      "aggregation": "weighted_standardized_components",
      "components": [
        {"code": "base_growth", "weight": 0.45, "direction": "higher", "metric": "B_new-B_old"},
        {"code": "efficiency_growth", "weight": 0.20, "direction": "higher", "metric": "Efficiency_new-Efficiency_old; Efficiency=Z(success)-Z(failure)"},
        {"code": "influence_growth", "weight": 0.20, "direction": "higher", "metric": "Influence_new-Influence_old"},
        {"code": "role_growth", "weight": 0.15, "direction": "higher", "metric": "Z(ln((Min_new+90)/(Min_old+90)))"}
      ],
      "final_formula": "MPS = .45*DeltaB + .20*DeltaEfficiency + .20*DeltaInfluence + .15*Z(RoleGrowth)",
      "tie_breakers": ["higher raw MPS", "higher base growth", "more second-half minutes", "player UUID ascending"]
    }
  ]
}
