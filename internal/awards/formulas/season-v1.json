    {
      "id": "10000000-0000-4000-8000-000000000005",
      "code": "IMPACT_SUBSTITUTE_OF_SEASON",
      "name": "Suplente más decisivo de la temporada",
      "version": 1,
      "status": "active",
      "eligibility": {
        "edition_state": "finalized",
        "minimum_substitute_appearances": 5,
        "minimum_substitute_minutes": 180,
        "maximum_starter_share": 0.5,
        "only_substitute_minutes_count": true
      },
      "aggregation": "weighted_percentiles",
      "components": [
        {
          "code": "decisive_actions",
          "weight": 0.35,
          "direction": "higher",
          "metric": "per90(4*winning_goals + 3*equalizing_goals + 2*other_goals + 1.5*assists); event score state defines decisive actions"
        },
        {
          "code": "score_swing",
          "weight": 0.25,
          "direction": "higher",
          "metric": "team league-points delta between substitution entry and final whistle, per substitute appearance"
