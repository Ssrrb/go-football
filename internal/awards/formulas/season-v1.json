{
  "specification": "go-football/season-awards",
  "catalog_version": 1,
  "status": "active",
  "normalization": {
    "method": "percentile_rank",
    "range": [
      0,
      1
    ],
    "cohort": "eligible players in the same edition and award",
    "ties": "average_rank",
    "outliers": "winsorize raw rates at cohort percentiles 0.05 and 0.95 before ranking",
    "missing_data": "required metrics make the player ineligible; optional metric weights are redistributed proportionally only when the formula explicitly allows it",
    "minimum_cohort_size": 10
  },
  "common_metrics": {
    "availability": "minutes / sum(team regulation minutes in matches for which the player was registered)",
    "consistency": "0.50 * share(rated matches with rating >= 7.0) + 0.50 * inverse_percentile(MAD(match ratings))",
    "goal_contribution_share": "(goals + assists) / team goals while the player was registered",
    "team_score_share": "sum(max(production_index * minutes/90, 0)) / sum(max(all team-player production_index * minutes/90, 0))",
    "result_involvement": "minute-weighted team league points / minutes",
    "influence": "0.40 * percentile(team_score_share) + 0.30 * percentile(goal_contribution_share) + 0.30 * percentile(result_involvement)",
    "success_index": "weighted_mean(pass_accuracy:0.35, tackle_accuracy:0.20, dribble_accuracy:0.15, cross_accuracy:0.10, long_ball_accuracy:0.10, shot_accuracy:0.10); category minimum attempts are 50, 5, 5, 5, 10, 5 respectively and available weights are redistributed proportionally",
    "error_index": "0.60 * percentile(1 - success_index) + 0.25 * percentile(dispossessed / touches) + 0.15 * percentile((fouls + 2*yellow_cards + 5*red_cards) / (minutes/90))",
    "production_index": "per90(5*goals + 3*assists + 0.5*shots_on_target + 0.10*duels_won + 0.15*tackles_won + 0.10*interceptions + 0.05*clearances + 0.05*recoveries + 0.01*passes_completed - 0.20*dispossessed - 0.50*fouls_committed - yellow_cards - 3*red_cards); percentile is calculated within position before cohorts are merged"
  },
  "awards": [
    {
