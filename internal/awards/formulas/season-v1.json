        "more substitute assists",
        "more substitute minutes",
        "player UUID ascending"
      ]
    },
    {
      "id": "10000000-0000-4000-8000-000000000006",
      "code": "MOST_IMPROVED_PLAYER",
      "name": "Jugador con mayor progresión",
      "version": 1,
      "status": "active",
      "eligibility": {
        "edition_state": "finalized",
        "windows": "with N finalized edition gameweeks and k=ceil(0.35*N), early = first k and late = last k ordered by number; require N >= 10 and non-overlapping windows; middle gameweeks are excluded",
        "minimum_minutes_per_window": 270,
        "minimum_appearances_per_window": 4,
        "minimum_rating_coverage_per_window": 0.6,
        "minimum_success_categories": 4
      },
      "aggregation": "weighted_percentile_deltas_centered",
      "reliability": "min(1, sqrt(min(early_minutes, late_minutes) / 540))",
      "components": [
        {
          "code": "quality_growth",
          "weight": 0.3,
          "direction": "higher",
          "metric": "late minutes-weighted mean rating - early minutes-weighted mean rating"
        },
        {
          "code": "success_growth",
          "weight": 0.2,
          "direction": "higher",
          "metric": "late common.success_index - early common.success_index; each rate uses completed/attempted counts"
        },
        {
          "code": "error_reduction",
          "weight": 0.2,
          "direction": "higher",
          "metric": "early common.error_index - late common.error_index"
        },
        {
          "code": "influence_growth",
          "weight": 0.2,
          "direction": "higher",
          "metric": "late common.influence - early common.influence"
        },
        {
          "code": "minutes_growth",
          "weight": 0.1,
          "direction": "higher",
          "metric": "late minutes share - early minutes share"
        }
      ],
      "final_formula": "score = 50 + 50 * reliability * sum(weight_i * (2 * percentile(delta_i) - 1)); clamp to [0,100]",
      "tie_breakers": [
        "higher influence growth",
        "higher success growth",
        "more late-window minutes",
        "player UUID ascending"
      ]
    }
