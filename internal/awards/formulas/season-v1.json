        {
          "code": "performance",
          "weight": 0.2,
          "direction": "higher",
          "metric": "common.production_index using substitute appearances only"
        },
        {
          "code": "frequency",
          "weight": 0.1,
          "direction": "higher",
          "metric": "share of substitute appearances with a goal, assist, or positive points swing"
        },
        {
          "code": "reliability",
          "weight": 0.1,
          "direction": "higher",
          "metric": "min(1, substitute_minutes / 540)"
        }
      ],
      "tie_breakers": [
