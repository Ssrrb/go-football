      "eligibility": {
        "edition_state": "finalized",
        "minimum_minutes": "max(900, 0.50 * team_possible_minutes)",
        "minimum_appearances": 10,
        "required_rating_coverage": 0.7,
        "resolved_position_required": true
      },
      "aggregation": "weighted_percentiles",
      "components": [
        {
          "code": "quality",
          "weight": 0.35,
          "direction": "higher",
          "metric": "minutes-weighted mean provider rating"
        },
        {
          "code": "production",
          "weight": 0.25,
          "direction": "higher",
          "metric": "common.production_index"
        },
        {
          "code": "influence",
          "weight": 0.2,
          "direction": "higher",
          "metric": "common.influence"
        },
        {
          "code": "consistency",
          "weight": 0.1,
          "direction": "higher",
          "metric": "common.consistency"
        },
        {
          "code": "availability",
          "weight": 0.1,
          "direction": "higher",
          "metric": "common.availability"
        }
      ],
      "tie_breakers": [
        "higher total minutes",
        "higher mean provider rating",
        "more appearances",
        "player UUID ascending"
      ]
    },
