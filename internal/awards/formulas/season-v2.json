        {"code": "sweeping", "weight": 0.1, "direction": "higher", "metric": "Z(attempt-adjusted keeper-sweeper success rate)"},
        {"code": "error_avoidance", "weight": 0.1, "direction": "higher", "metric": "Z(-errors leading to shots or goals per 90)"},
