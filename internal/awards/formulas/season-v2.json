{
  "specification": "go-football/season-awards",
  "catalog_version": 2,
  "status": "active",
  "normalization": {
    "method": "positional_robust_z_score",
    "formula": "(x - median(position, metric)) / (1.4826 * MAD(position, metric))",
    "fallback": "use positional standard Z-score when MAD is zero; use 0 when the cohort has no dispersion",
    "cohort": "players in the same edition, position and calculation window",
    "rate_adjustment": "shrink rates toward the positional cohort rate with metric-specific pseudo-attempts before standardization",
    "missing_data": "a required unavailable metric makes the player ineligible; zero is used only when the provider semantics establish that an omitted count means no actions"
  },
  "common_metrics": {
    "reliability": "R = minutes / (minutes + 900)",
    "season_volume": "V = sqrt(minutes / maximum player minutes in the edition cohort)",
    "quality": "Q = w_A*A + w_P*P + w_D*D + w_C*C + w_I*I; A, P, D, C and I are positional robust Z-scores",
    "position_weights": "GK=(.05,.10,.10,.30,.45); DEF=(.10,.20,.35,.20,.15); MID=(.15,.30,.15,.20,.20); FWD=(.35,.20,.05,.15,.25) for (A,P,D,C,I)",
    "public_scale": "the raw standardized award score determines ranking; 100/(1+exp(-raw_score)) is used only to display it on a 0-100 scale"
  },
  "awards": [
    {
      "id": "20000000-0000-4000-8000-000000000001",
      "code": "PLAYER_OF_SEASON",
      "name": "Jugador de la temporada",
      "version": 2,
      "status": "active",
      "eligibility": {
        "resolved_position_required": true,
        "provisional": "one finished appearance; reliability controls the round-four sample",
        "final": "same calculation over all 22 rounds"
      },
      "aggregation": "weighted_standardized_components",
      "components": [
        {"code": "reliable_quality", "weight": 0.8, "direction": "higher", "metric": "Q * minutes/(minutes+900)"},
        {"code": "season_volume", "weight": 0.2, "direction": "higher", "metric": "sqrt(minutes/maximum player minutes)"}
      ],
      "final_formula": "JTS = 0.80*(Q*R) + 0.20*V",
      "tie_breakers": ["higher raw JTS", "higher total minutes", "player UUID ascending"]
    },
    {
      "id": "20000000-0000-4000-8000-000000000002",
      "code": "DEFENDER_OF_SEASON",
      "name": "Defensa de la temporada",
      "version": 2,
      "status": "active",
      "eligibility": {"position": "DEF", "provisional": "one finished appearance"},
      "aggregation": "weighted_standardized_components",
      "components": [
        {"code": "reliable_defence", "weight": 0.85, "direction": "higher", "metric": "DEF * minutes/(minutes+900); DEF=.20*Z(duel win rate)+.15*Z(aerial win rate)+.20*Z(interceptions/90)+.15*Z(tackles/90)+.10*Z(blocks/90)+.10*Z(recoveries/90)+.10*Z(progression/90)-.10*Z(errors/90)"},
        {"code": "season_volume", "weight": 0.15, "direction": "higher", "metric": "sqrt(minutes/maximum defender minutes)"}
      ],
      "final_formula": "DTS = 0.85*(DEF*R) + 0.15*V",
      "tie_breakers": ["higher raw DTS", "higher total minutes", "player UUID ascending"]
    },
    {
      "id": "20000000-0000-4000-8000-000000000003",
      "code": "GOALKEEPER_OF_SEASON",
      "name": "Portero de la temporada",
      "version": 2,
      "status": "active",
      "eligibility": {"position": "GK", "minimum_shots_on_target_faced": 1},
      "aggregation": "weighted_standardized_components",
      "components": [
        {"code": "reliable_shot_stopping", "weight": 0.4, "direction": "higher", "metric": "Z(save percentage adjusted for attempts) * SOTFaced/(SOTFaced+100); use Z((PSxG-GA)/SOTFaced) when PSxG is available"},
        {"code": "distribution", "weight": 0.2, "direction": "higher", "metric": "Z(attempt-adjusted pass and long-ball accuracy)"},
